# {{ ansible_managed }}
[mysqld]
performance_schema={{ 'ON' if mariadb_performance_schema else 'OFF' }}
{% if not mariadb_binary_logging %}
skip-log-bin
{% endif %}
{% if mariadb_innodb_buffer_pool_size == 'auto' %}
# A share of the server's RAM (the database runs next to PHP and nginx)
innodb_buffer_pool_size={{ [((ansible_memtotal_mb | default(1024)) * (mariadb_innodb_buffer_pool_ratio | default(0.25))) | int, 128] | max }}M
{% else %}
innodb_buffer_pool_size={{ mariadb_innodb_buffer_pool_size }}
{% endif %}
max_connections={{ mariadb_max_connections }}
character-set-server={{ mariadb_character_set }}
collation-server={{ mariadb_collation }}

# Many sites means many tables (a WordPress site has 12+, plus its plugins').
table_open_cache={{ mariadb_table_open_cache | default(8000) }}
table_definition_cache={{ mariadb_table_definition_cache | default(4000) }}
open_files_limit={{ mariadb_open_files_limit | default(65535) }}
tmp_table_size={{ mariadb_tmp_table_size | default('64M') }}
max_heap_table_size={{ mariadb_tmp_table_size | default('64M') }}

{% if mariadb_slow_query_log %}
# Each entry names the database user, which is the site (pressctl-site-stats
# groups them by site).
slow_query_log=1
slow_query_log_file=/var/log/mysql/mariadb-slow.log
long_query_time={{ mariadb_long_query_time }}
{% endif %}
