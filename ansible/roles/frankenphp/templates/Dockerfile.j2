# {{ ansible_managed }}
# pressctl FrankenPHP image: upstream FrankenPHP + WordPress PHP extensions + WP-CLI
ARG PHP_VERSION={{ php_version }}
FROM {{ frankenphp_base_image }}

# Install the PHP extensions WordPress needs. install-php-extensions ships with
# the FrankenPHP image and handles distro packages + build deps automatically.
RUN install-php-extensions {{ frankenphp_php_extensions | join(' ') }}

# WP-CLI (downloaded via ADD so no extra packages are required at build time)
ADD https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar /usr/local/bin/wp
RUN chmod +x /usr/local/bin/wp
