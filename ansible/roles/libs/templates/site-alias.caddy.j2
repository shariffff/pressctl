# {{ ansible_managed }}
# Additional domain {{ domain }} for the site rooted at /sites/{{ site_domain }}/files.
# Caddy obtains TLS automatically once DNS for {{ domain }} points here.
{{ domain }} {
	root * /sites/{{ site_domain }}/files
	encode zstd gzip
	# Log into the primary site's access log so per-site accounting includes
	# alias traffic. Caddy shares one writer across blocks with the same output.
	log {
		output file /sites/{{ site_domain }}/logs/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
	}
	php_server
}
