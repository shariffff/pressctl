# Basic location blocks shared by all sites. # {{ ansible_managed }}

# Serve a static disallow-all robots.txt for temporary *.sailurl.com domains,
# so search engines never index staging URLs.
location = /robots.txt {
	if ($host ~* "(sailurl.com)$") {
		add_header Content-Type text/plain;
		return 200 "# Changes to this robots.txt are blocked for *sailurl.com domains.\n# Only available for custom domains.\n\nUser-agent: *\nDisallow: /\n\n";
	}
	allow all;
	try_files $uri $uri/ /index.php?$args;
	access_log off;
	log_not_found off;
}

location = /ads.txt {
	allow all;
	try_files $uri $uri/;
	access_log off;
	log_not_found off;
}

location = /analytics.txt {
	allow all;
	try_files $uri $uri/;
	access_log off;
	log_not_found off;
}
