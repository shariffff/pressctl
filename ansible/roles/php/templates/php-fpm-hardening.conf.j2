# {{ ansible_managed }}
# Sandboxing for PHP-FPM (every site's PHP runs under this service).
[Service]
# A site's PHP sees only its own processes in /proc, not other sites'.
ProtectProc=invisible
# /usr, /boot and /etc are read-only; /home, /root and /run/user are hidden.
ProtectSystem=full
ProtectHome=yes
# A private /tmp for PHP (each site also has its own temp dir).
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Sites can write files under /sites, but PHP must never run or load code
# from there as a program or library: putenv('LD_PRELOAD=...') followed by
# mail() would otherwise load a site's own .so into the sendmail shell, outside
# open_basedir and disable_functions. PHP scripts are read, not executed, so
# this does not affect them.
NoExecPaths=/sites
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
LimitNOFILE=65535
