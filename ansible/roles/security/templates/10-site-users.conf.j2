# {{ ansible_managed }}
# Site owners sign in as their site's own user. Password sign-in is allowed
# for them only (it is off for everyone else, including root); the password is
# always one we generate, and fail2ban watches the sshd log. Forwarding is off
# so a login cannot be used to reach the server's local services. Their shell is
# the sandbox in /usr/local/bin/pressctl-shell, so ~/.ssh/rc (which sshd would run
# outside the sandbox) and ~/.ssh/environment are switched off.
Match Group site-users
    PasswordAuthentication yes
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
    GatewayPorts no
    PermitUserRC no
    PermitUserEnvironment no
