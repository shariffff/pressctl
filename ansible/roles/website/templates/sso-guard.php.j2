<?php
/**
 * WordSail site-tool SSO guard.
 *
 * Standalone SSO gate for tools that are not WordPress (the elFinder file manager,
 * Adminer). wp-admin SSO is handled by the wordsail-connector plugin.
 * Verifies a single-use panel
 * token against the control panel, then issues a short-lived cookie that
 * gates access to the tool.
 *
 * Usage:
 *   require __DIR__ . '/sso-guard.php';
 *   wordsail_tool_sso_guard('filemanager'); // or 'adminer'
 *
 * The cookie name is derived from the tool so each tool has an isolated
 * session, and the token is only ever consumed on the redirect that
 * established the session (never left in the address bar afterwards).
 *
 * The cookie value is an expiry time and a random nonce with an HMAC-SHA256
 * over both (and the tool's name), keyed by a per-site secret stored 0600 in
 * .sso-secret next to this file. The HMAC makes the cookie unforgeable, the
 * signed expiry makes it stop working after the TTL even if it was copied,
 * and the tool name keeps one tool's cookie from opening the other.
 */

// Guard against direct web access to this file: it defines functions only,
// so requesting it bare should not be possible to abuse. Nothing else to do.
if (!defined('ABSPATH') && basename($_SERVER['SCRIPT_NAME'] ?? '') === 'sso-guard.php') {
    http_response_code(404);
    exit;
}

const WORDSAIL_TOOL_SSO_SERVER = '{{ wordsail_sso_server | default("managed.wordsail.com") }}';
// Other panels (e.g. staging) a request may pick with ?x_src_url=. Only hosts
// the operator lists in wordsail_sso_extra_servers; none by default.
const WORDSAIL_TOOL_SSO_EXTRA_SERVERS = {{ (wordsail_sso_extra_servers | default([]) | map('lower') | list) | to_json }};
const WORDSAIL_TOOL_SSO_ENDPOINT = '/api/hosting/v1/wp-sso/';
const WORDSAIL_TOOL_SSO_COOKIE_TTL = 3600;      // 1 hour, rolling
const WORDSAIL_TOOL_SSO_COOKIE_PREFIX = 'wordsail_sso_';

/**
 * Gate a request for $tool.
 *
 * - No cookie + valid ?token=  -> verify against panel, set cookie, redirect clean.
 * - No cookie, no token        -> render a 401 "sign in from panel" page.
 * - Cookie present and valid   -> allow (re-issue cookie to roll the TTL).
 * - Cookie/token invalid       -> 403, never leave a spent token in the URL.
 */
function wordsail_tool_sso_guard(string $tool): void
{
    $cookie = WORDSAIL_TOOL_SSO_COOKIE_PREFIX . $tool;

    if (wordsail_tool_sso_valid_cookie($cookie, $tool)) {
        wordsail_tool_sso_reissue($cookie, $tool);
        return;
    }

    $had_cookie = isset($_COOKIE[$cookie]);
    $token = isset($_GET['token']) ? trim((string) $_GET['token']) : '';
    if ($token !== '' && preg_match('/^[a-zA-Z0-9]{64}$/', $token) && wordsail_tool_sso_verify($token)) {
        wordsail_tool_sso_issue($cookie, $tool);
        wordsail_tool_sso_redirect_clean();
    }

    // 401 when no credentials were offered at all; 403 when a cookie or token
    // was present but invalid, expired, or already consumed.
    wordsail_tool_sso_deny(($had_cookie || $token !== '') ? 403 : 401);
}

/**
 * Verify a panel token and confirm it was minted for this site. The panel
 * returns the site's domain, which must match the host being logged into.
 */
function wordsail_tool_sso_verify(string $token): bool
{
    $ctx = stream_context_create(array(
        'http' => array(
            'method'        => 'GET',
            'timeout'       => 10,
            'ignore_errors' => true,
            'header'        => "User-Agent: WordSail Site Tools\r\n",
        ),
        'ssl' => array(
            'verify_peer'      => true,
            'verify_peer_name' => true,
        ),
    ));

    $url = 'https://' . wordsail_tool_sso_server() . WORDSAIL_TOOL_SSO_ENDPOINT . rawurlencode($token);
    $body = @file_get_contents($url, false, $ctx);

    if ($body === false) {
        return false;
    }

    // file_get_contents with ignore_errors swallows status; check it ourselves.
    $status = 0;
    foreach ($http_response_header ?? array() as $header) {
        if (preg_match('#^HTTP/\S+\s+(\d{3})#', $header, $m)) {
            $status = (int) $m[1];
        }
    }
    if ($status !== 200) {
        return false;
    }

    $data = json_decode($body, true);
    if (!is_array($data) || empty($data['domain']) || !is_string($data['domain'])) {
        return false;
    }

    $request_host = wordsail_tool_sso_request_host();
    return '' !== $request_host && hash_equals(strtolower($data['domain']), $request_host);
}

/**
 * The host nginx served this request for (its $host, passed as
 * PRESSCTL_SITE_HOST by the tool locations), lowercased and without a port.
 * Not the client's Host header: with an absolute URL in the request line nginx
 * picks the site from that URL, so the Host header could name a different
 * site than the one whose tools (secret, database, files) are being unlocked.
 */
function wordsail_tool_sso_request_host(): string
{
    $host = isset($_SERVER['PRESSCTL_SITE_HOST']) ? strtolower(trim((string) $_SERVER['PRESSCTL_SITE_HOST'])) : '';
    if ($host === '') {
        return '';
    }
    return (string) preg_replace('/:\d+$/', '', $host);
}

/**
 * Panel host to verify against. A staging panel may pass x_src_url, but only
 * a host the operator listed in wordsail_sso_extra_servers is used: the
 * verifier decides who gets in, so the request must not get to choose it.
 */
function wordsail_tool_sso_server(): string
{
    if (!empty($_GET['x_src_url'])) {
        $host = parse_url((string) $_GET['x_src_url'], PHP_URL_HOST);
        if (is_string($host) && in_array(strtolower($host), WORDSAIL_TOOL_SSO_EXTRA_SERVERS, true)) {
            return strtolower($host);
        }
    }
    return WORDSAIL_TOOL_SSO_SERVER;
}

/**
 * Issue the session cookie. The value is a random nonce plus an HMAC over it
 * keyed by the per-site secret, so possession of a well-formed cookie is not
 * enough to authenticate.
 */
function wordsail_tool_sso_issue(string $cookie, string $tool): void
{
    $expires = time() + WORDSAIL_TOOL_SSO_COOKIE_TTL;
    $nonce = bin2hex(random_bytes(32));
    $value = $expires . '.' . $nonce . '.' . wordsail_tool_sso_sign($tool, $expires, $nonce);
    wordsail_tool_sso_set_cookie($cookie, $value, $expires);
}

/**
 * Re-issue (roll) the cookie so an active session never goes stale. Each value
 * carries its own signed expiry, so a copied value stops working after the TTL.
 */
function wordsail_tool_sso_reissue(string $cookie, string $tool): void
{
    wordsail_tool_sso_issue($cookie, $tool);
}

function wordsail_tool_sso_set_cookie(string $cookie, string $value, int $expires): void
{
    $secure = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')
        || (($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '') === 'https');

    setcookie(
        $cookie,
        $value,
        array(
            'expires'  => $expires,
            'path'     => '/',
            'secure'   => $secure,
            'httponly' => true,
            'samesite' => 'Lax',
        )
    );
}

/**
 * The per-site signing secret. Stored 0600 in .sso-secret alongside this
 * file and never served by nginx. Absence means the guard is misconfigured:
 * fail closed rather than silently accepting unsigned cookies.
 */
function wordsail_tool_sso_secret(): string
{
    static $secret = null;

    if ($secret === null) {
        $file = __DIR__ . '/.sso-secret';
        $value = is_readable($file) ? trim((string) @file_get_contents($file)) : '';
        if ($value === '' || preg_match('/^[a-f0-9]{64}$/i', $value) !== 1) {
            $secret = false;
        } else {
            $secret = $value;
        }
    }

    return $secret === false ? '' : $secret;
}

/**
 * HMAC-SHA256 signature over the tool, expiry and nonce, hex encoded.
 */
function wordsail_tool_sso_sign(string $tool, int $expires, string $nonce): string
{
    return hash_hmac('sha256', $tool . '|' . $expires . '|' . $nonce, wordsail_tool_sso_secret());
}

function wordsail_tool_sso_valid_cookie(string $cookie, string $tool): bool
{
    if (!isset($_COOKIE[$cookie])) {
        return false;
    }

    $value = (string) $_COOKIE[$cookie];

    // Format: <expiry unix time>.<64 hex nonce>.<64 hex signature>.
    if (preg_match('/^(\d{1,12})\.([a-f0-9]{64})\.([a-f0-9]{64})$/', $value, $m) !== 1) {
        return false;
    }

    $secret = wordsail_tool_sso_secret();
    if ($secret === '') {
        return false;
    }

    $expires = (int) $m[1];
    $now = time();
    if ($expires < $now || $expires > $now + WORDSAIL_TOOL_SSO_COOKIE_TTL + 60) {
        return false;
    }

    $expected = hash_hmac('sha256', $tool . '|' . $expires . '|' . $m[2], $secret);

    return hash_equals($expected, $m[3]);
}

/**
 * Redirect back to the clean tool URL (no token in the address bar).
 */
function wordsail_tool_sso_redirect_clean(): void
{
    $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
    $host   = wordsail_tool_sso_request_host();
    $uri    = (string) ($_SERVER['REQUEST_URI'] ?? '/');

    // Strip the token and x_src_url params from the current URI.
    $clean = preg_replace('/([?&])(token|x_src_url)=[^&]*/', '', $uri);
    $clean = rtrim((string) preg_replace('/[?&]$/', '', $clean), '?');

    header('Location: ' . $scheme . '://' . $host . $clean, true, 302);
    exit;
}

/**
 * Deny page for unauthenticated (401) or failed (403) attempts. The token is
 * never echoed, and the response must never be cached.
 */
function wordsail_tool_sso_deny(int $status): void
{
    http_response_code($status);
    header('Content-Type: text/html; charset=utf-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
    header('Pragma: no-cache');
    echo '<!doctype html><html><head><meta charset="utf-8"><title>Sign in required</title></head>'
        . '<body style="font-family:sans-serif;text-align:center;padding-top:4rem">'
        . '<h1>Sign in required</h1>'
        . '<p>This tool is protected by WordSail SSO. Open it from your WordSail control panel.</p>'
        . '</body></html>';
    exit;
}
